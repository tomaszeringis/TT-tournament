# Tournament Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# On Streamlit Cloud, set these as Secrets instead.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENABLE_SELF_REGISTRATION=true
PUBLIC_BOARD_BASE_URL=http://localhost:8501

# ---------------------------------------------------------------------------
# Voice Scorekeeper — ASR backend selection
# ---------------------------------------------------------------------------
# Batch ASR (used for calibration, push-to-talk, and fallback):
VOICE_ASR_BACKEND=faster_whisper
# Streaming ASR (used for continuous voice scoring):
VOICE_STREAMING_ASR_BACKEND=deepgram

# ---------------------------------------------------------------------------
# Voice Scorekeeper — Deepgram Nova-3 streaming provider (pilot)
# ---------------------------------------------------------------------------
VOICE_DEEPGRAM_ENABLED=false
VOICE_DEEPGRAM_API_KEY=
VOICE_DEEPGRAM_MODEL=nova-3
VOICE_DEEPGRAM_LANGUAGE=lt
VOICE_DEEPGRAM_ENDPOINTING_MS=300
VOICE_DEEPGRAM_INTERIM_RESULTS=true
VOICE_DEEPGRAM_KEEPALIVE_SECONDS=4
VOICE_DEEPGRAM_SAMPLE_RATE=16000
VOICE_DEEPGRAM_CHANNELS=1
VOICE_DEEPGRAM_KEYTERMS_ENABLED=true
VOICE_DEEPGRAM_MAX_KEYTERMS=100
VOICE_DEEPGRAM_CONNECT_TIMEOUT_SECONDS=10
VOICE_DEEPGRAM_RECONNECT_ATTEMPTS=3
VOICE_DEEPGRAM_REGION=default

# ---------------------------------------------------------------------------
# Voice Scorekeeper — Audio health check & VAD calibration
# ---------------------------------------------------------------------------
VOICE_AUDIO_HEALTH_CHECK_ENABLED=true
VOICE_AUDIO_HEALTH_CHECK_REQUIRED=false
VOICE_AUDIO_HEALTH_AMBIENT_SECONDS=2
VOICE_AUDIO_HEALTH_SAMPLE_COMMAND_ENABLED=false
VOICE_AUDIO_HEALTH_STORE_AUDIO=false

VOICE_LOCAL_VAD_MODE=continuous
VOICE_LOCAL_VAD_ALLOW_DEGRADED_FALLBACK=true
VOICE_VAD_TRAILING_AUDIO_MS=400

VOICE_DEEPGRAM_FINALIZE_TIMEOUT_MS=1200
VOICE_DEEPGRAM_MAX_UTTERANCE_MS=10000
